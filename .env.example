# Copie este arquivo para ".env.local" e preencha os valores.
# Veja o README.md para o passo-a-passo completo de como obter cada um.

# Senha para acessar a dashboard (protege seus dados do Facebook Ads).
# Usuário fixo: admin
DASHBOARD_PASSWORD=troque-por-uma-senha-forte

# Chaves VAPID para as notificações push (gere com: npm run generate-vapid)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com

# Segredo usado para proteger o endpoint /api/cron/check, que dispara as
# verificações de regras e o envio de notificações. Gere uma string
# aleatória e configure o mesmo valor no seu serviço de cron (cron-job.org,
# GitHub Actions, Vercel Cron, etc).
CRON_SECRET=troque-por-uma-string-aleatoria

# Caminho do arquivo do banco SQLite local (opcional, tem um padrão).
# DB_PATH=./data/app.sqlite
